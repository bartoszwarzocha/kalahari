# Kalahari C++ Static Analysis Configuration
#
# A focused set of checks that find real bugs and performance problems.
# CI runs clang-tidy only on the lines a pull request changes
# (.github/workflows/ci-linux.yml, job "analysis"), so every warning is
# reported as an error there.
#
# Disabled checks:
# - bugprone-easily-swappable-parameters, bugprone-narrowing-conversions,
#   bugprone-implicit-widening-of-multiplication-result: too noisy for Qt code
#   (int/qsizetype conversions everywhere)
# - bugprone-chained-comparison: false positives in every Catch2 REQUIRE()
# - performance-enum-size: memory gain is negligible for this codebase

---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-chained-comparison,
  clang-analyzer-*,
  performance-*,
  -performance-enum-size,
  modernize-use-nullptr,
  modernize-use-override

WarningsAsErrors: '*'

# Only report problems in Kalahari headers, not in Qt or other dependencies
HeaderFilterRegex: 'include/kalahari/.*'

CheckOptions:
  - key: modernize-use-override.IgnoreDestructors
    value: 'true'
  - key: performance-move-const-arg.CheckTriviallyCopyableMove
    value: 'false'
...
