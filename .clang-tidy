# Kalahari C++ Static Analysis Configuration
#
# A focused set of checks that find real bugs and performance problems.
# CI runs clang-tidy only on the lines a pull request changes
# (.github/workflows/ci-linux.yml, job "analysis"), so every warning is
# reported as an error there.
#
# Disabled checks:
# - bugprone-easily-swappable-parameters, bugprone-narrowing-conversions,
#   bugprone-implicit-widening-of-multiplication-result: too noisy for Qt code
#   (int/qsizetype conversions everywhere)
# - bugprone-chained-comparison: false positives in every Catch2 REQUIRE()
# - performance-enum-size: memory gain is negligible for this codebase

---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-chained-comparison,
  clang-analyzer-*,
  performance-*,
  -performance-enum-size,
  modernize-use-nullptr,
  modernize-use-override

WarningsAsErrors: '*'

# Only report problems in Kalahari headers (the program's, the tests' shared ones and the
# internal ones in src/), not in Qt or other dependencies; both path separators, because
# clang writes the paths of includes on Windows with both
HeaderFilterRegex: '(include[/\\]kalahari|include[/\\]kalahari_tests|src)[/\\].*'

CheckOptions:
  - key: modernize-use-override.IgnoreDestructors
    value: 'true'
  - key: performance-move-const-arg.CheckTriviallyCopyableMove
    value: 'false'
  # misc-include-cleaner (SonarQube analysis, scripts/sonar_analysis.py): Qt's classes
  # are included through their public headers (<QString>), which only include the
  # internal files that declare them (qstring.h); the check cannot see that and would
  # add the internal files, against Qt's usage. Qt's headers are left to the code.
  - key: misc-include-cleaner.IgnoreHeaders
    value: 'Qt[A-Za-z0-9]*/.*'
  # modernize-use-default-member-init (SonarQube analysis): an initializer moved out of a
  # constructor is written as the members around it are, m_x = nullptr rather than m_x{nullptr}
  - key: modernize-use-default-member-init.UseAssignment
    value: 'true'
...
