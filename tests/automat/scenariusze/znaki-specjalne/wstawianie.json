{
  "id": "znaki-specjalne-wstawianie",
  "title": "Okno „Znak specjalny”: Enter wstawia znak w miejscu kursora",
  "area": "Znaki specjalne",
  "tags": ["czasy"],
  "sources": [
    { "kind": "plan", "ref": "plan-faz.md – Pełny edytor, część 3: znaki specjalne, okno „Znak specjalny…”" },
    { "kind": "mockup", "ref": "makiety/znaki-specjalne.html – „Enter wstawia znak do rozdziału w miejscu kursora”; „Zostaw okno otwarte po wstawieniu” domyślnie zaznaczone: znak się wstawia, a okno zostaje (jak w Wordzie, tak jest w planie)" },
    { "kind": "decision", "ref": "Progi z 17.11.2026: okno 0,5 s, reakcja 0,3 s" }
  ],
  "setup": {
    "books": ["karawana"],
    "settings": "domyslne",
    "open": { "book": "karawana", "chapter": "Targ w Ghadames" }
  },
  "steps": [
    {
      "say": "Napisz w rozdziale „Znak:”",
      "do": "type",
      "text": "Znak:",
      "expect": [
        { "check": "editor_text", "contains": "Znak:" }
      ]
    },
    { "do": "use", "block": "otworz-znak-specjalny" },
    {
      "do": "type",
      "text": "pauza",
      "target": { "window": "Znak specjalny", "name": "Szukaj znaku", "role": "edit" },
      "expect": [
        { "check": "checked", "target": { "window": "Znak specjalny", "name": "Zostaw okno otwarte po wstawieniu", "role": "check_box" } }
      ]
    },
    {
      "do": "keys",
      "keys": "Enter",
      "expect": [
        { "check": "editor_text", "contains": "Znak:—" },
        { "check": "visible", "target": { "window": "Znak specjalny" } }
      ]
    },
    {
      "say": "Zamknij okno klawiszem Esc",
      "do": "keys",
      "keys": "Esc",
      "expect": [
        { "check": "window_closed", "window": "Znak specjalny" }
      ]
    }
  ]
}
