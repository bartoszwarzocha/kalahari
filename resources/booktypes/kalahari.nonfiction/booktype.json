{
  "format": 1,
  "id": "kalahari.nonfiction",
  "version": "1.0",
  "role": "type",
  "name": { "pl": "Literatura faktu", "en": "Non-fiction" },
  "description": {
    "pl": "Książka popularnonaukowa, historyczna albo reportaż.",
    "en": "Popular science, history or reportage."
  },
  "icon": "template.nonfiction",
  "uses": ["kalahari.base"],
  "kinds": {
    "abbreviations": {
      "form": "text", "places": ["front"], "limit": 1, "icon": "template.chapter",
      "name": { "pl": "Wykaz skrótów", "en": "List of abbreviations" },
      "plural": { "pl": "Wykazy skrótów", "en": "Lists of abbreviations" },
      "words": {
        "pl": { "gender": "masculine", "singular": "wykaz skrótów", "plural": "wykazy skrótów",
                "genitive": "wykazu skrótów", "dative": "wykazowi skrótów",
                "accusative": "wykaz skrótów", "instrumental": "wykazem skrótów",
                "locative": "wykazie skrótów", "genitivePlural": "wykazów skrótów" },
        "en": { "singular": "list of abbreviations", "plural": "lists of abbreviations",
                "indefinite": "a list of abbreviations" }
      }
    },
    "conclusion": {
      "form": "text", "places": ["main"], "limit": 1, "position": "end",
      "icon": "template.chapter",
      "name": { "pl": "Zakończenie", "en": "Conclusion" },
      "plural": { "pl": "Zakończenia", "en": "Conclusions" },
      "words": {
        "pl": { "gender": "neuter", "singular": "zakończenie", "plural": "zakończenia",
                "genitive": "zakończenia", "dative": "zakończeniu", "accusative": "zakończenie",
                "instrumental": "zakończeniem", "locative": "zakończeniu",
                "genitivePlural": "zakończeń" },
        "en": { "singular": "conclusion", "plural": "conclusions", "indefinite": "a conclusion" }
      }
    },
    "annex": {
      "form": "text", "places": ["back"], "icon": "template.chapter",
      "name": { "pl": "Aneks", "en": "Appendix" },
      "plural": { "pl": "Aneksy", "en": "Appendices" },
      "words": {
        "pl": { "gender": "masculine", "singular": "aneks", "plural": "aneksy",
                "genitive": "aneksu", "dative": "aneksowi", "accusative": "aneks",
                "instrumental": "aneksem", "locative": "aneksie", "genitivePlural": "aneksów" },
        "en": { "singular": "appendix", "plural": "appendices", "indefinite": "an appendix" }
      },
      "title": { "pl": "Aneks %n", "en": "Appendix %n" }
    },
    "endnotes": {
      "form": "window", "editor": "endnotes", "generated": true,
      "places": ["back"], "limit": 1, "icon": "insert.endnote",
      "name": { "pl": "Przypisy końcowe", "en": "Endnotes" },
      "plural": { "pl": "Przypisy końcowe", "en": "Endnotes" },
      "words": {
        "pl": { "gender": "plural", "singular": "przypisy końcowe", "plural": "przypisy końcowe",
                "genitive": "przypisów końcowych", "dative": "przypisom końcowym",
                "accusative": "przypisy końcowe", "instrumental": "przypisami końcowymi",
                "locative": "przypisach końcowych", "genitivePlural": "przypisów końcowych" },
        "en": { "gender": "plural", "singular": "endnotes", "plural": "endnotes",
                "indefinite": "endnotes" }
      }
    },
    "bibliography": {
      "form": "window", "editor": "bibliography", "generated": true,
      "places": ["back"], "limit": 1, "icon": "format.bullets",
      "name": { "pl": "Bibliografia", "en": "Bibliography" },
      "plural": { "pl": "Bibliografie", "en": "Bibliographies" },
      "words": {
        "pl": { "gender": "feminine", "singular": "bibliografia", "plural": "bibliografie",
                "genitive": "bibliografii", "dative": "bibliografii", "accusative": "bibliografię",
                "instrumental": "bibliografią", "locative": "bibliografii",
                "genitivePlural": "bibliografii" },
        "en": { "singular": "bibliography", "plural": "bibliographies",
                "indefinite": "a bibliography" }
      }
    },
    "index": {
      "form": "window", "editor": "index", "generated": true,
      "places": ["back"], "limit": 1, "icon": "common.sort",
      "name": { "pl": "Indeks", "en": "Index" },
      "plural": { "pl": "Indeksy", "en": "Indexes" },
      "words": {
        "pl": { "gender": "masculine", "singular": "indeks", "plural": "indeksy",
                "genitive": "indeksu", "dative": "indeksowi", "accusative": "indeks",
                "instrumental": "indeksem", "locative": "indeksie", "genitivePlural": "indeksów" },
        "en": { "singular": "index", "plural": "indexes", "indefinite": "an index" }
      }
    },
    "illustrations": {
      "form": "window", "editor": "illustrations", "generated": true,
      "places": ["back"], "limit": 1, "icon": "insert.image",
      "name": { "pl": "Spis ilustracji", "en": "List of illustrations" },
      "plural": { "pl": "Spisy ilustracji", "en": "Lists of illustrations" },
      "words": {
        "pl": { "gender": "masculine", "singular": "spis ilustracji", "plural": "spisy ilustracji",
                "genitive": "spisu ilustracji", "dative": "spisowi ilustracji",
                "accusative": "spis ilustracji", "instrumental": "spisem ilustracji",
                "locative": "spisie ilustracji", "genitivePlural": "spisów ilustracji" },
        "en": { "singular": "list of illustrations", "plural": "lists of illustrations",
                "indefinite": "a list of illustrations" }
      }
    },
    "source": {
      "form": "window", "editor": "card", "places": ["workshop"], "icon": "common.filePresent",
      "workshopGroup": "libraries", "retired": true,
      "name": { "pl": "Źródło", "en": "Source" },
      "plural": { "pl": "Źródła", "en": "Sources" },
      "words": {
        "pl": { "gender": "neuter", "singular": "źródło", "plural": "źródła", "genitive": "źródła",
                "dative": "źródłu", "accusative": "źródło", "instrumental": "źródłem",
                "locative": "źródle", "genitivePlural": "źródeł" },
        "en": { "singular": "source", "plural": "sources", "indefinite": "a source" }
      },
      "title": { "pl": "Źródło %n", "en": "Source %n" }
    }
  },
  "front":    ["title_page", "copyright", "dedication", "motto", "toc", "preface", "introduction",
               "abbreviations"],
  "main":     ["part", "chapter", "conclusion"],
  "back":     ["annex", "endnotes", "bibliography", "glossary", "index", "illustrations",
               "acknowledgments", "about_author", "toc"],
  "workshop": ["timeline", "mindmap", "work_note", "clipping", "cover", "publishing", "quote",
               "web_page", "picture", "document", "publication", "recording", "other_file"],
  "primary":  "chapter",
  "start":    ["title_page", "introduction", "chapter"],
  "styles":   "styles.json",
  "publishingTemplates": [
    { "id": "proposal", "part": "synopsis",
      "name": { "pl": "Konspekt książki", "en": "Book proposal" },
      "points": [
        { "id": "topic",
          "name": { "pl": "Temat i teza", "en": "Topic and thesis" },
          "hint": { "pl": "O czym jest książka i co twierdzi.",
                    "en": "What the book is about and what it claims." } },
        { "id": "readers",
          "name": { "pl": "Dla kogo", "en": "Readers" },
          "hint": { "pl": "Kto przeczyta tę książkę i co z niej wyniesie.",
                    "en": "Who will read the book and what they will take from it." } },
        { "id": "new",
          "name": { "pl": "Co nowego wnosi", "en": "What is new" },
          "hint": { "pl": "Czym różni się od innych książek na ten temat.",
                    "en": "How it differs from other books on the subject." } },
        { "id": "sources",
          "name": { "pl": "Źródła", "en": "Sources" },
          "hint": { "pl": "Na czym opiera się książka: badania, rozmowy, archiwa.",
                    "en": "What the book is based on: research, interviews, archives." } },
        { "id": "plan",
          "name": { "pl": "Plan rozdziałów", "en": "Chapter plan" },
          "hint": { "pl": "Rozdziały, każdy w jednym zdaniu.",
                    "en": "The chapters, one sentence each." } }
      ],
      "target": { "characters": 3600, "words": 600 } },
    { "id": "each_chapter", "part": "synopsis",
      "name": { "pl": "Rozdział po rozdziale", "en": "Chapter by chapter" },
      "eachText": true,
      "hint": { "pl": "Dwa, trzy zdania: o czym jest rozdział i co z niego wynika.",
                "en": "Two or three sentences: what the chapter is about and what follows from it." },
      "target": { "characters": 600, "words": 100 } },
    { "id": "shows_how", "part": "pitch",
      "name": { "pl": "Ta książka pokazuje…, jak…, bo…", "en": "This book shows… how… because…" },
      "pattern": { "pl": "Ta książka pokazuje {readers}, jak {what}, bo {why}.",
                   "en": "This book shows {readers} how {what}, because {why}." },
      "fields": [
        { "id": "readers",
          "name": { "pl": "komu", "en": "whom" },
          "hint": { "pl": "dla kogo jest książka", "en": "who the book is for" } },
        { "id": "what",
          "name": { "pl": "jak", "en": "how" },
          "hint": { "pl": "czego się dowiedzą", "en": "what they will learn" } },
        { "id": "why",
          "name": { "pl": "dlaczego", "en": "why" },
          "hint": { "pl": "dlaczego to ważne teraz", "en": "why it matters now" } }
      ],
      "target": { "characters": 200, "words": 35 } },
    { "id": "comparison", "part": "pitch",
      "name": { "pl": "Porównanie z inną książką", "en": "Comparison with another book" },
      "pattern": { "pl": "{model} {world}: {new}.", "en": "{model} {world}: {new}." },
      "fields": [
        { "id": "model",
          "name": { "pl": "znana książka albo styl", "en": "known book or style" },
          "hint": { "pl": "np. kryminał w stylu Agathy Christie",
                    "en": "e.g. a mystery in the style of Agatha Christie" } },
        { "id": "world",
          "name": { "pl": "świat książki", "en": "world of the book" },
          "hint": { "pl": "gdzie i kiedy", "en": "where and when" } },
        { "id": "new",
          "name": { "pl": "co nowego", "en": "what is new" },
          "hint": { "pl": "co wyróżnia Twoją książkę", "en": "what sets your book apart" } }
      ],
      "target": { "characters": 150, "words": 25 } }
  ]
}
