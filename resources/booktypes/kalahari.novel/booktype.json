{
  "format": 1,
  "id": "kalahari.novel",
  "version": "1.0",
  "role": "type",
  "name": { "pl": "Powieść", "en": "Novel" },
  "description": {
    "pl": "Proza fabularna w rozdziałach, które można łączyć w części.",
    "en": "Fiction in chapters, which can be grouped into parts."
  },
  "icon": "template.novel",
  "uses": ["kalahari.base"],
  "kinds": {
    "prologue": {
      "form": "text", "places": ["main", "part"], "limit": 1, "position": "start",
      "icon": "template.chapter",
      "name": { "pl": "Prolog", "en": "Prologue" },
      "plural": { "pl": "Prologi", "en": "Prologues" },
      "words": {
        "pl": { "gender": "masculine", "singular": "prolog", "plural": "prologi",
                "genitive": "prologu", "dative": "prologowi", "accusative": "prolog",
                "instrumental": "prologiem", "locative": "prologu", "genitivePlural": "prologów" },
        "en": { "singular": "prologue", "plural": "prologues", "indefinite": "a prologue" }
      }
    },
    "epilogue": {
      "form": "text", "places": ["main", "part"], "limit": 1, "position": "end",
      "icon": "template.chapter",
      "name": { "pl": "Epilog", "en": "Epilogue" },
      "plural": { "pl": "Epilogi", "en": "Epilogues" },
      "words": {
        "pl": { "gender": "masculine", "singular": "epilog", "plural": "epilogi",
                "genitive": "epilogu", "dative": "epilogowi", "accusative": "epilog",
                "instrumental": "epilogiem", "locative": "epilogu", "genitivePlural": "epilogów" },
        "en": { "singular": "epilogue", "plural": "epilogues", "indefinite": "an epilogue" }
      }
    }
  },
  "front":    ["title_page", "copyright", "dedication", "motto", "toc", "preface"],
  "main":     ["prologue", "part", "chapter", "epilogue"],
  "back":     ["afterword", "acknowledgments", "glossary", "about_author", "toc"],
  "workshop": ["mindmap", "timeline", "character", "location", "item", "work_note", "cover",
               "quote", "web_page", "picture", "document", "publication", "recording",
               "other_file"],
  "primary":  "chapter",
  "start":    ["title_page", "chapter"],
  "styles":   "styles.json",
  "publishingTemplates": [
    { "id": "one_page", "part": "synopsis",
      "name": { "pl": "Jedna strona – pięć kroków", "en": "One page – five steps" },
      "points": [
        { "id": "hero",
          "name": { "pl": "Bohater i świat", "en": "Hero and world" },
          "hint": { "pl": "Kim jest bohater, gdzie i kiedy toczy się akcja.",
                    "en": "Who the hero is, where and when the story takes place." } },
        { "id": "event",
          "name": { "pl": "Wydarzenie, które wszystko zmienia",
                    "en": "The event that changes everything" },
          "hint": { "pl": "Co wyrywa bohatera z codzienności i zaczyna historię.",
                    "en": "What takes the hero out of everyday life and starts the story." } },
        { "id": "goal",
          "name": { "pl": "Cel i przeszkody", "en": "Goal and obstacles" },
          "hint": { "pl": "Czego bohater chce, kto i co mu przeszkadza, jak rosną stawki.",
                    "en": "What the hero wants, who and what stands in the way, how the stakes rise." } },
        { "id": "climax",
          "name": { "pl": "Punkt kulminacyjny", "en": "Climax" },
          "hint": { "pl": "Najtrudniejsza próba – moment, w którym wszystko się rozstrzyga.",
                    "en": "The hardest trial – the moment when everything is decided." } },
        { "id": "ending",
          "name": { "pl": "Zakończenie", "en": "Ending" },
          "hint": { "pl": "Jak kończy się historia i co bohater zyskuje albo traci. Wydawnictwo chce znać zakończenie.",
                    "en": "How the story ends and what the hero gains or loses. Publishers want to know the ending." } }
      ],
      "target": { "characters": 1800, "words": 300 } },
    { "id": "full", "part": "synopsis",
      "name": { "pl": "Pełne streszczenie – do trzech stron",
                "en": "Full synopsis – up to three pages" },
      "points": [
        { "id": "beginning",
          "name": { "pl": "Początek", "en": "Beginning" },
          "hint": { "pl": "Świat, bohater i to, czego mu brakuje.",
                    "en": "The world, the hero and what the hero lacks." } },
        { "id": "turn",
          "name": { "pl": "Pierwszy zwrot", "en": "First turn" },
          "hint": { "pl": "Co wyrywa bohatera z codzienności.",
                    "en": "What takes the hero out of everyday life." } },
        { "id": "middle",
          "name": { "pl": "Rozwinięcie", "en": "Development" },
          "hint": { "pl": "Kolejne próby, sojusznicy i przeciwnicy.",
                    "en": "The trials, the allies and the enemies." } },
        { "id": "subplots",
          "name": { "pl": "Wątki poboczne", "en": "Subplots" },
          "hint": { "pl": "Najważniejsze, w jednym albo dwóch zdaniach każdy.",
                    "en": "The most important ones, in a sentence or two each." } },
        { "id": "climax",
          "name": { "pl": "Kulminacja", "en": "Climax" },
          "hint": { "pl": "Najtrudniejsza próba.", "en": "The hardest trial." } },
        { "id": "ending",
          "name": { "pl": "Zakończenie", "en": "Ending" },
          "hint": { "pl": "Jak kończy się historia i co się zmienia.",
                    "en": "How the story ends and what changes." } }
      ],
      "target": { "characters": 5400, "words": 900 } },
    { "id": "each_chapter", "part": "synopsis",
      "name": { "pl": "Rozdział po rozdziale", "en": "Chapter by chapter" },
      "eachText": true,
      "hint": { "pl": "Dwa, trzy zdania: co się dzieje w rozdziale i co się zmienia.",
                "en": "Two or three sentences: what happens in the chapter and what changes." },
      "target": { "characters": 600, "words": 100 } },
    { "id": "when_must", "part": "pitch",
      "name": { "pl": "Gdy… musi… zanim…", "en": "When… must… before…" },
      "pattern": { "pl": "Gdy {event}, {hero} musi {goal}, zanim {stakes}.",
                   "en": "When {event}, {hero} must {goal} before {stakes}." },
      "fields": [
        { "id": "event",
          "name": { "pl": "co się dzieje", "en": "what happens" },
          "hint": { "pl": "zdarzenie, które wszystko zmienia",
                    "en": "the event that changes everything" } },
        { "id": "hero",
          "name": { "pl": "bohater", "en": "hero" },
          "hint": { "pl": "kim jest bohater", "en": "who the hero is" } },
        { "id": "goal",
          "name": { "pl": "cel", "en": "goal" },
          "hint": { "pl": "co bohater musi zrobić", "en": "what the hero must do" } },
        { "id": "stakes",
          "name": { "pl": "stawka", "en": "stakes" },
          "hint": { "pl": "co się stanie, jeśli nie zdąży",
                    "en": "what happens if the hero fails" } }
      ],
      "target": { "characters": 200, "words": 35 } },
    { "id": "hero_goal", "part": "pitch",
      "name": { "pl": "Bohater, cel, przeszkoda", "en": "Hero, goal, obstacle" },
      "pattern": { "pl": "{hero}, {who}, chce {goal}, ale {obstacle}.",
                   "en": "{hero}, {who}, wants {goal}, but {obstacle}." },
      "fields": [
        { "id": "hero",
          "name": { "pl": "bohater", "en": "hero" },
          "hint": { "pl": "imię bohatera", "en": "the hero's name" } },
        { "id": "who",
          "name": { "pl": "kim jest", "en": "who" },
          "hint": { "pl": "kilka słów o bohaterze", "en": "a few words about the hero" } },
        { "id": "goal",
          "name": { "pl": "cel", "en": "goal" },
          "hint": { "pl": "czego bohater chce", "en": "what the hero wants" } },
        { "id": "obstacle",
          "name": { "pl": "przeszkoda", "en": "obstacle" },
          "hint": { "pl": "co albo kto mu przeszkadza", "en": "what or who stands in the way" } }
      ],
      "target": { "characters": 200, "words": 35 } },
    { "id": "comparison", "part": "pitch",
      "name": { "pl": "Porównanie z inną książką", "en": "Comparison with another book" },
      "pattern": { "pl": "{model} {world}: {new}.", "en": "{model} {world}: {new}." },
      "fields": [
        { "id": "model",
          "name": { "pl": "znana książka albo styl", "en": "known book or style" },
          "hint": { "pl": "np. kryminał w stylu Agathy Christie",
                    "en": "e.g. a mystery in the style of Agatha Christie" } },
        { "id": "world",
          "name": { "pl": "świat książki", "en": "world of the book" },
          "hint": { "pl": "gdzie i kiedy", "en": "where and when" } },
        { "id": "new",
          "name": { "pl": "co nowego", "en": "what is new" },
          "hint": { "pl": "co wyróżnia Twoją książkę", "en": "what sets your book apart" } }
      ],
      "target": { "characters": 150, "words": 25 } }
  ]
}
