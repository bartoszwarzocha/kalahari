{
  "format": 1,
  "id": "kalahari.poetry",
  "version": "1.0",
  "role": "type",
  "name": { "pl": "Tomik wierszy", "en": "Poetry Collection" },
  "description": {
    "pl": "Wiersze, które można łączyć w cykle.",
    "en": "Poems, which can be grouped into cycles."
  },
  "icon": "template.poetry",
  "uses": ["kalahari.base"],
  "kinds": {
    "poem": {
      "form": "text", "places": ["main", "cycle"], "icon": "template.chapter",
      "name": { "pl": "Wiersz", "en": "Poem" },
      "plural": { "pl": "Wiersze", "en": "Poems" },
      "words": {
        "pl": { "gender": "masculine", "singular": "wiersz", "plural": "wiersze",
                "genitive": "wiersza", "dative": "wierszowi", "accusative": "wiersz",
                "instrumental": "wierszem", "locative": "wierszu", "genitivePlural": "wierszy" },
        "en": { "singular": "poem", "plural": "poems", "indefinite": "a poem" }
      },
      "title": { "pl": "Wiersz %n", "en": "Poem %n" }
    },
    "cycle": {
      "form": "group", "places": ["main"], "icon": "structure.part",
      "name": { "pl": "Cykl", "en": "Cycle" },
      "plural": { "pl": "Cykle", "en": "Cycles" },
      "words": {
        "pl": { "gender": "masculine", "singular": "cykl", "plural": "cykle", "genitive": "cyklu",
                "dative": "cyklowi", "accusative": "cykl", "instrumental": "cyklem",
                "locative": "cyklu", "genitivePlural": "cykli", "locativePlural": "cyklach" },
        "en": { "singular": "cycle", "plural": "cycles", "indefinite": "a cycle" }
      },
      "title": { "pl": "Cykl %n", "en": "Cycle %n" }, "numbering": "roman"
    },
    "explanatory_notes": {
      "form": "text", "places": ["back"], "limit": 1, "icon": "template.chapter",
      "name": { "pl": "Objaśnienia", "en": "Notes" },
      "plural": { "pl": "Objaśnienia", "en": "Notes" },
      "words": {
        "pl": { "gender": "plural", "singular": "objaśnienia", "plural": "objaśnienia",
                "genitive": "objaśnień", "dative": "objaśnieniom", "accusative": "objaśnienia",
                "instrumental": "objaśnieniami", "locative": "objaśnieniach",
                "genitivePlural": "objaśnień" },
        "en": { "gender": "plural", "singular": "notes", "plural": "notes", "indefinite": "notes" }
      }
    },
    "first_lines": {
      "form": "window", "editor": "first_lines", "generated": true,
      "places": ["back"], "limit": 1, "icon": "common.sort",
      "name": { "pl": "Indeks pierwszych wersów", "en": "Index of first lines" },
      "plural": { "pl": "Indeksy pierwszych wersów", "en": "Indexes of first lines" },
      "words": {
        "pl": { "gender": "masculine", "singular": "indeks pierwszych wersów",
                "plural": "indeksy pierwszych wersów", "genitive": "indeksu pierwszych wersów",
                "dative": "indeksowi pierwszych wersów", "accusative": "indeks pierwszych wersów",
                "instrumental": "indeksem pierwszych wersów",
                "locative": "indeksie pierwszych wersów",
                "genitivePlural": "indeksów pierwszych wersów" },
        "en": { "singular": "index of first lines", "plural": "indexes of first lines",
                "indefinite": "an index of first lines" }
      }
    },
    "publisher_note": {
      "form": "text", "places": ["back"], "limit": 1, "icon": "template.chapter",
      "name": { "pl": "Nota wydawnicza", "en": "Publisher's note" },
      "plural": { "pl": "Noty wydawnicze", "en": "Publisher's notes" },
      "words": {
        "pl": { "gender": "feminine", "singular": "nota wydawnicza", "plural": "noty wydawnicze",
                "genitive": "noty wydawniczej", "dative": "nocie wydawniczej",
                "accusative": "notę wydawniczą", "instrumental": "notą wydawniczą",
                "locative": "nocie wydawniczej", "genitivePlural": "not wydawniczych" },
        "en": { "singular": "publisher's note", "plural": "publisher's notes",
                "indefinite": "a publisher's note" }
      }
    },
    "draft": {
      "form": "text", "places": ["workshop"], "icon": "template.note",
      "name": { "pl": "Brudnopis", "en": "Draft" },
      "plural": { "pl": "Brudnopisy", "en": "Drafts" },
      "words": {
        "pl": { "gender": "masculine", "singular": "brudnopis", "plural": "brudnopisy",
                "genitive": "brudnopisu", "dative": "brudnopisowi", "accusative": "brudnopis",
                "instrumental": "brudnopisem", "locative": "brudnopisie",
                "genitivePlural": "brudnopisów" },
        "en": { "singular": "draft", "plural": "drafts", "indefinite": "a draft" }
      },
      "title": { "pl": "Brudnopis %n", "en": "Draft %n" }
    }
  },
  "front":    ["title_page", "copyright", "dedication", "motto", "toc", "introduction"],
  "main":     ["cycle", "poem"],
  "back":     ["explanatory_notes", "about_author", "first_lines", "publisher_note", "toc"],
  "workshop": ["draft", "mindmap", "work_note", "clipping", "cover", "publishing", "quote",
               "web_page", "picture", "document", "publication", "recording", "other_file"],
  "primary":  "poem",
  "start":    ["title_page", "poem"],
  "styles":   "styles.json",
  "publishingTemplates": [
    { "id": "collection", "part": "synopsis",
      "name": { "pl": "Opis tomiku", "en": "About the collection" },
      "points": [
        { "id": "motifs",
          "name": { "pl": "Motywy", "en": "Motifs" },
          "hint": { "pl": "O czym są wiersze i co je łączy.",
                    "en": "What the poems are about and what links them." } },
        { "id": "form",
          "name": { "pl": "Forma i język", "en": "Form and language" },
          "hint": { "pl": "Wiersz wolny czy rymowany, jaki język, jaki ton.",
                    "en": "Free verse or rhyme, what language, what tone." } },
        { "id": "parts",
          "name": { "pl": "Układ części", "en": "Order of the parts" },
          "hint": { "pl": "Jak tomik jest podzielony i dlaczego.",
                    "en": "How the collection is divided and why." } }
      ],
      "target": { "characters": 1800, "words": 300 } },
    { "id": "poems_about", "part": "pitch",
      "name": { "pl": "Wiersze o…, w których…", "en": "Poems about… in which…" },
      "pattern": { "pl": "Wiersze o {theme}, w których {what}.",
                   "en": "Poems about {theme} in which {what}." },
      "fields": [
        { "id": "theme",
          "name": { "pl": "temat", "en": "theme" },
          "hint": { "pl": "o czym są wiersze", "en": "what the poems are about" } },
        { "id": "what",
          "name": { "pl": "co się dzieje", "en": "what happens" },
          "hint": { "pl": "co wiersze robią z tematem", "en": "what the poems do with the theme" } }
      ],
      "target": { "characters": 200, "words": 35 } }
  ]
}
