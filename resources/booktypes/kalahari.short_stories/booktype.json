{
  "format": 1,
  "id": "kalahari.short_stories",
  "version": "1.0",
  "role": "type",
  "name": { "pl": "Zbiór opowiadań", "en": "Short Story Collection" },
  "description": {
    "pl": "Opowiadania jednego autora albo antologia; opowiadania można łączyć w działy.",
    "en": "Stories by one author or an anthology; stories can be grouped into divisions."
  },
  "icon": "template.shortStories",
  "uses": ["kalahari.base", "kalahari.novel"],
  "kinds": {
    "story": {
      "form": "text", "places": ["main", "section"], "icon": "template.chapter",
      "name": { "pl": "Opowiadanie", "en": "Story" },
      "plural": { "pl": "Opowiadania", "en": "Stories" },
      "words": {
        "pl": { "gender": "neuter", "singular": "opowiadanie", "plural": "opowiadania",
                "genitive": "opowiadania", "dative": "opowiadaniu", "accusative": "opowiadanie",
                "instrumental": "opowiadaniem", "locative": "opowiadaniu",
                "genitivePlural": "opowiadań" },
        "en": { "singular": "story", "plural": "stories", "indefinite": "a story" }
      },
      "title": { "pl": "Opowiadanie %n", "en": "Story %n" }
    },
    "section": {
      "form": "group", "places": ["main"], "icon": "structure.part",
      "name": { "pl": "Dział", "en": "Division" },
      "plural": { "pl": "Działy", "en": "Divisions" },
      "words": {
        "pl": { "gender": "masculine", "singular": "dział", "plural": "działy",
                "genitive": "działu", "dative": "działowi", "accusative": "dział",
                "instrumental": "działem", "locative": "dziale", "genitivePlural": "działów",
                "locativePlural": "działach" },
        "en": { "singular": "division", "plural": "divisions", "indefinite": "a division" }
      },
      "title": { "pl": "Dział %n", "en": "Division %n" }, "numbering": "roman"
    },
    "contributors": {
      "form": "text", "places": ["back"], "limit": 1, "icon": "template.chapter",
      "name": { "pl": "Noty o autorach", "en": "Notes on contributors" },
      "plural": { "pl": "Noty o autorach", "en": "Notes on contributors" },
      "words": {
        "pl": { "gender": "plural", "singular": "noty o autorach", "plural": "noty o autorach",
                "genitive": "not o autorach", "dative": "notom o autorach",
                "accusative": "noty o autorach", "instrumental": "notami o autorach",
                "locative": "notach o autorach", "genitivePlural": "not o autorach" },
        "en": { "gender": "plural", "singular": "notes on contributors",
                "plural": "notes on contributors", "indefinite": "notes on contributors" }
      }
    },
    "first_publications": {
      "form": "window", "editor": "first_publications", "generated": true,
      "places": ["back"], "limit": 1, "icon": "format.bullets",
      "name": { "pl": "Pierwodruki", "en": "First publications" },
      "plural": { "pl": "Pierwodruki", "en": "First publications" },
      "words": {
        "pl": { "gender": "plural", "singular": "pierwodruki", "plural": "pierwodruki",
                "genitive": "pierwodruków", "dative": "pierwodrukom", "accusative": "pierwodruki",
                "instrumental": "pierwodrukami", "locative": "pierwodrukach",
                "genitivePlural": "pierwodruków" },
        "en": { "gender": "plural", "singular": "first publications",
                "plural": "first publications", "indefinite": "first publications" }
      }
    }
  },
  "front":    ["title_page", "copyright", "dedication", "motto", "toc", "introduction"],
  "main":     ["story", "section"],
  "back":     ["contributors", "first_publications", "acknowledgments", "about_author", "toc"],
  "workshop": ["mindmap", "character", "location", "work_note", "cover", "quote", "web_page",
               "picture", "document", "publication", "recording", "other_file"],
  "primary":  "story",
  "start":    ["title_page", "story"],
  "styles":   "styles.json",
  "publishingTemplates": [
    { "id": "collection", "part": "synopsis",
      "name": { "pl": "Opis zbioru", "en": "About the collection" },
      "points": [
        { "id": "theme",
          "name": { "pl": "Co łączy opowiadania", "en": "What links the stories" },
          "hint": { "pl": "Wspólny temat, miejsce, bohater albo nastrój.",
                    "en": "A shared theme, place, character or mood." } },
        { "id": "best",
          "name": { "pl": "Najmocniejsze opowiadania", "en": "The strongest stories" },
          "hint": { "pl": "Dwa, trzy opowiadania, od których warto zacząć, i dlaczego.",
                    "en": "Two or three stories to start with, and why." } },
        { "id": "form",
          "name": { "pl": "Forma i układ", "en": "Form and order" },
          "hint": { "pl": "Długość opowiadań, sposób opowiadania, kolejność w zbiorze.",
                    "en": "The length of the stories, the way they are told, their order in the collection." } }
      ],
      "target": { "characters": 1800, "words": 300 } },
    { "id": "each_story", "part": "synopsis",
      "name": { "pl": "Opowiadanie po opowiadaniu", "en": "Story by story" },
      "eachText": true,
      "hint": { "pl": "Dwa zdania: o czym jest opowiadanie i jak się kończy.",
                "en": "Two sentences: what the story is about and how it ends." },
      "target": { "characters": 400, "words": 70 } },
    { "id": "stories_about", "part": "pitch",
      "name": { "pl": "Opowiadania o…, w których…", "en": "Stories about… in which…" },
      "pattern": { "pl": "{number} opowiadań o {theme}, w których {what}.",
                   "en": "{number} stories about {theme} in which {what}." },
      "fields": [
        { "id": "number",
          "name": { "pl": "ile", "en": "how many" },
          "hint": { "pl": "liczba opowiadań, np. dwanaście",
                    "en": "the number of stories, e.g. twelve" } },
        { "id": "theme",
          "name": { "pl": "temat", "en": "theme" },
          "hint": { "pl": "co łączy opowiadania", "en": "what links the stories" } },
        { "id": "what",
          "name": { "pl": "co się dzieje", "en": "what happens" },
          "hint": { "pl": "co przeżywają bohaterowie", "en": "what the characters go through" } }
      ],
      "target": { "characters": 200, "words": 35 } },
    { "id": "comparison", "part": "pitch",
      "name": { "pl": "Porównanie z inną książką", "en": "Comparison with another book" },
      "pattern": { "pl": "{model} {world}: {new}.", "en": "{model} {world}: {new}." },
      "fields": [
        { "id": "model",
          "name": { "pl": "znana książka albo styl", "en": "known book or style" },
          "hint": { "pl": "np. kryminał w stylu Agathy Christie",
                    "en": "e.g. a mystery in the style of Agatha Christie" } },
        { "id": "world",
          "name": { "pl": "świat książki", "en": "world of the book" },
          "hint": { "pl": "gdzie i kiedy", "en": "where and when" } },
        { "id": "new",
          "name": { "pl": "co nowego", "en": "what is new" },
          "hint": { "pl": "co wyróżnia Twoją książkę", "en": "what sets your book apart" } }
      ],
      "target": { "characters": 150, "words": 25 } }
  ]
}
