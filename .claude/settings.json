{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/*)",
      "Bash(git:*)",
      "Bash(cmake:*)",
      "Bash(ctest:*)",
      "Bash(cd:*)",
      "Bash(dir:*)",
      "Bash(ls:*)",
      "Bash(echo:*)",
      "Bash(type:*)",
      "Bash(cat:*)",
      "Bash(./build-windows/bin/*)",
      "Bash(./build-linux/bin/*)",
      "Read(src/**)",
      "Read(include/**)",
      "Read(tests/**)",
      "Read(docs/**)",
      "Read(.claude/**)",
      "Edit(src/**)",
      "Edit(include/**)",
      "Edit(tests/**)",
      "Edit(docs/superpowers/**)",
      "Edit(.claude/**)",
      "Agent(architect)",
      "Agent(coder)",
      "Agent(code-reviewer)",
      "Agent(tester)",
      "Agent(devops)",
      "Agent(Explore)",
      "Skill(save-session)",
      "Skill(load-session)",
      "mcp__context7",
      "mcp__serena"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Bash(rm -rf:*)",
      "Bash(del /s:*)",
      "Bash(format:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(Invoke-WebRequest:*)",
      "Bash(powershell -enc:*)",
      "Edit(.env)",
      "Edit(.env.*)"
    ]
  },
  "enabledMcpjsonServers": [
    "context7",
    "serena"
  ],
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/build_reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_commit_check.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
