#!/bin/bash
# =============================================================================
# Kalahari Pre-Commit Hook - C++ Code Pattern Validator
# =============================================================================
# Validates C++ patterns before each commit. Based on:
#   .claude/rules/patterns.md
#
# Checks for:
#   - QIcon("...") usage (should use ArtProvider::getInstance().getIcon())
#   - QColor(r,g,b) usage (should use ArtProvider colors)
#   - qDebug() usage (should use Logger::getInstance())
#   - std::cout usage (should use Logger::getInstance())
#
# Only the lines a commit adds are checked: a file that already had such a line
# can still be changed, and every new violation blocks the commit. Comment lines
# are skipped.
#
# Install: scripts/install-hooks.sh (copies this file to .git/hooks/pre-commit)
# =============================================================================

# Colors (portable)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# Pattern definitions (centralized for consistency)
# QIcon pattern: matches QIcon("..."), QIcon('...'), or QIcon varname("...")
PATTERN_QICON='QIcon(\s+\w+)?\s*\(\s*["'"'"']'
# QColor pattern: matches QColor(r, g, b) with numeric values
PATTERN_QCOLOR='QColor\s*\(\s*[0-9]+\s*,\s*[0-9]+\s*,\s*[0-9]+'
# qDebug pattern: matches qDebug(), qWarning(), qCritical(), qInfo()
PATTERN_QDEBUG='(qDebug|qWarning|qCritical|qInfo)\s*\('
# std::cout pattern: matches std::cout <<, std::cerr <<, std::clog <<
PATTERN_STDOUT='std::(cout|cerr|clog)\s*<<'

# =============================================================================
# Helper functions
# =============================================================================
print_header() {
    echo ""
    echo -e "${BLUE}==========================================${NC}"
    echo -e "${BLUE}  Kalahari C++ Pattern Validator${NC}"
    echo -e "${BLUE}==========================================${NC}"
    echo ""
}

print_success() {
    echo -e "${GREEN}[OK]${NC} $1"
}

print_file_header() {
    echo -e "${CYAN}File:${NC} ${BOLD}$1${NC}"
}

print_violation() {
    local line_num="$1"
    local violation_type="$2"
    local bad_pattern="$3"
    local good_pattern="$4"
    local line_content="$5"

    echo -e "  ${RED}Line $line_num:${NC} $violation_type"
    echo -e "    ${YELLOW}Found:${NC}    $line_content"
    echo -e "    ${RED}Bad:${NC}      $bad_pattern"
    echo -e "    ${GREEN}Use:${NC}      $good_pattern"
    echo ""
}

# Lines the staged version of a file adds, as "<line number><TAB><text>"
# (numbers of the new version, from the hunk headers of a diff without context)
added_lines() {
    git diff --cached -U0 --no-color --diff-filter=ACM -- "$1" 2>/dev/null | tr -d '\r' | awk '
        /^@@/ { split($3, start, ","); line = substr(start[1], 2) + 0; next }
        /^\+\+\+/ { next }
        /^\+/ { printf "%d\t%s\n", line, substr($0, 2); line++; next }
    '
}

# Checks the added lines of one file: prints its violations, sets FILE_ERRORS
check_file() {
    local file="$1"
    local count=0
    local header_printed=0
    local line_num line_content kind bad good

    while IFS=$'\t' read -r line_num line_content; do
        # Skip comment lines (same rule as before: any line with a comment marker)
        case "$line_content" in
            *"//"*|*"/*"*|*"*"*) continue ;;
        esac
        kind=""
        if echo "$line_content" | grep -qE "$PATTERN_QICON"; then
            kind="Direct QIcon usage"
            bad="QIcon(\"path/to/icon.svg\")"
            good="core::ArtProvider::getInstance().getIcon(\"icon_id\")"
        elif echo "$line_content" | grep -qE "$PATTERN_QCOLOR"; then
            kind="Hardcoded QColor RGB values"
            bad="QColor(255, 0, 0)"
            good="core::ArtProvider::getInstance().getPrimaryColor() or theme colors"
        elif echo "$line_content" | grep -qE "$PATTERN_QDEBUG"; then
            kind="Qt debug macro usage"
            bad="qDebug() << \"message\""
            good="core::Logger::getInstance().debug(\"message: {}\", value)"
        elif echo "$line_content" | grep -qE "$PATTERN_STDOUT"; then
            kind="Standard output stream usage"
            bad="std::cout << \"message\""
            good="core::Logger::getInstance().info(\"message: {}\", value)"
        fi
        if [ -n "$kind" ]; then
            if [ "$header_printed" -eq 0 ]; then
                print_file_header "$file"
                header_printed=1
            fi
            print_violation "$line_num" "$kind" "$bad" "$good" "$line_content"
            count=$((count + 1))
        fi
    done < <(added_lines "$file")

    FILE_ERRORS=$count
}

# =============================================================================
# Main logic
# =============================================================================

print_header

# Get staged C++ files
# CRITICAL: Use tr -d '\r' to handle Windows CRLF line endings
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | tr -d '\r' | grep -E '\.(cpp|h|hpp)$' || true)

if [ -z "$STAGED_FILES" ]; then
    print_success "No C++ files staged for commit."
    echo ""
    exit 0
fi

echo -e "${BLUE}Checking the lines added to staged C++ files...${NC}"
echo ""

ERRORS=0
FILES_CHECKED=0

while IFS= read -r file; do
    [ -z "$file" ] && continue
    [ ! -f "$file" ] && continue
    FILES_CHECKED=$((FILES_CHECKED + 1))
    check_file "$file"
    ERRORS=$((ERRORS + FILE_ERRORS))
done <<< "$STAGED_FILES"

# =============================================================================
# Summary
# =============================================================================

echo -e "${BLUE}==========================================${NC}"

if [ "$ERRORS" -gt 0 ]; then
    echo -e "${RED}${BOLD}COMMIT BLOCKED${NC}"
    echo ""
    echo -e "${RED}Found $ERRORS pattern violation(s) in the lines added to $FILES_CHECKED file(s)${NC}"
    echo ""
    echo -e "${YELLOW}Please fix the violations above before committing.${NC}"
    echo -e "${YELLOW}Reference: .claude/rules/patterns.md${NC}"
    echo ""
    echo -e "${BLUE}==========================================${NC}"
    echo ""
    exit 1
else
    echo -e "${GREEN}${BOLD}All checks passed!${NC}"
    echo -e "${GREEN}Checked the added lines of $FILES_CHECKED file(s), no pattern violations found.${NC}"
    echo -e "${BLUE}==========================================${NC}"
    echo ""
    exit 0
fi
